TELEGRAM_API_ID=api_id
TELEGRAM_API_HASH=api_hash
BOT_TOKEN=your_bot_token

BASE_URL=https://api.telegram.org/bot
# BASE_URL=http://localhost:8081/bot

# Set true ONLY when BASE_URL points at a telegram-bot-api server started with
# --local: videos are then passed by file path (file:// URI) instead of being
# read into bot memory, and the server must see the media folder at the same
# absolute path as the bot. docker-compose.yml enables this automatically.
LOCAL_MODE=false
# File-download endpoint; derived from BASE_URL (.../bot -> .../file/bot) when unset
# BASE_FILE_URL=http://localhost:8081/file/bot

DEVELOPER_CHAT_ID=developer_chat_id
DEVELOPER_ID=developer_id
READ_TIMEOUT=300

LOADING_VIDEO_ID=loading_animation_video_url
ANIMATION_FILE_ID=animation_video_file_id

CONFIG_FOLDER=./config
EMPTY_MEDIA_FOLDER=true

# Max simultaneous video-file uploads; keep at 1 to bound memory and IO
# UPLOAD_CONCURRENCY=1
# Path to a cookies file for yt-dlp. Caution: yt-dlp rewrites the cookie jar
# after each extraction — do not share the file between concurrent instances
# COOKIES_FILE=

# Leave blank to auto-generate a strong password (written to data/dashboard_password.txt).
# Required (same value) on both nodes of an HA pair: the auto-generated file is per host
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080
# Set to true when the dashboard sits behind a reverse proxy (Traefik, nginx, ...):
# login rate limiting uses the real client IP from X-Forwarded-For, and the session
# cookie is marked Secure when the proxy reports HTTPS via X-Forwarded-Proto
DASHBOARD_BEHIND_PROXY=false
# Bearer token for the JSON API under /api/ (Authorization: Bearer <token>).
# Leave blank to auto-generate a strong token (written to data/api_token.txt).
# Required (same value) on both nodes of an HA pair: the auto-generated file is per host
API_TOKEN=

# --- High availability (optional; leave PEER_URL and SYNC_SECRET blank for a single node) ---
# Role of this node: primary (reclaims after FAILBACK_STABLE_SEC) or standby
NODE_ROLE=primary
NODE_NAME=dasovbot
# Dashboard URL of the OTHER node by static LAN IP, e.g. http://192.168.11.150:8080 (hostnames do not
# resolve inside gluetun; never a floating/virtual IP)
PEER_URL=
# Shared bearer secret for /sync/*; must be identical on both nodes, separate from API_TOKEN
SYNC_SECRET=
HEARTBEAT_INTERVAL_SEC=10
LEASE_TTL_SEC=30
FAILBACK_STABLE_SEC=180

BACKUP_CRON=0 */12 * * *
BACKUP_MAX_COUNT=14
