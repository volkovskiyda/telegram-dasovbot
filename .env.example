TELEGRAM_API_ID=api_id
TELEGRAM_API_HASH=api_hash
BOT_TOKEN=your_bot_token

BASE_URL=https://api.telegram.org/bot
# BASE_URL=http://localhost:8081/bot

# Set true ONLY when BASE_URL points at a telegram-bot-api server started with
# --local: videos are then passed by file path (file:// URI) instead of being
# read into bot memory, and the server must see the media folder at the same
# absolute path as the bot. docker-compose.yml enables this automatically.
LOCAL_MODE=false
# File-download endpoint; derived from BASE_URL (.../bot -> .../file/bot) when unset
# BASE_FILE_URL=http://localhost:8081/file/bot

DEVELOPER_CHAT_ID=developer_chat_id
DEVELOPER_ID=developer_id
# Bot API request timeout. The code default is 30 s; a local --local server
# takes multi-GB uploads in one request, hence the generous value here
READ_TIMEOUT=300

LOADING_VIDEO_ID=loading_animation_video_url
ANIMATION_FILE_ID=animation_video_file_id

CONFIG_FOLDER=./config
# Clear the media folder when the intent worker crashes and restarts. Code
# default false; true is right for a container where nothing else lives there
EMPTY_MEDIA_FOLDER=true
# Health alert when the media, export or data volume has less than this many GB free; 0 disables
DISK_FREE_MIN_GB=20

# Max simultaneous video-file uploads; keep at 1 to bound memory and IO
# UPLOAD_CONCURRENCY=1
# Path to a cookies file for yt-dlp. Caution: yt-dlp rewrites the cookie jar
# after each extraction — do not share the file between concurrent instances
# COOKIES_FILE=

# --- Dashboard and API secrets ---
# Leave any of the three blank to auto-generate a strong value once: it is
# written to data/<name>.txt (mode 0600) and read back on every later start,
# so it stays stable across restarts. The files are per host: on an HA pair
# set all three explicitly to the same value on both nodes and keep the files
# out of Syncthing (see docs/ha.md "Syncthing")
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080
# Set to true when the dashboard sits behind a reverse proxy (Traefik, nginx, ...):
# login rate limiting uses the real client IP from X-Forwarded-For, the session
# cookie is marked Secure when the proxy reports HTTPS via X-Forwarded-Proto,
# and X-Forwarded-Host counts as the dashboard's own origin for POSTs
DASHBOARD_BEHIND_PROXY=false
# Read-only bearer token for /api/videos (Authorization: Bearer <token>); data/api_token.txt when blank
API_TOKEN=
# Bearer token for the admin API (every /api/ route); data/admin_token.txt when blank.
# Keep it separate from API_TOKEN: the read-only token must never be able to ban or subscribe
ADMIN_TOKEN=

# --- High availability (optional; leave PEER_URL and SYNC_SECRET blank for a single node) ---
# Role of this node: primary (reclaims after FAILBACK_STABLE_SEC) or standby
NODE_ROLE=primary
NODE_NAME=dasovbot
# Dashboard URL of the OTHER node by static LAN IP, e.g. http://192.168.1.10:8080 (hostnames do not
# resolve inside gluetun; never a floating/virtual IP)
PEER_URL=
# Shared bearer secret for /sync/*; must be identical on both nodes, separate from API_TOKEN
SYNC_SECRET=
HEARTBEAT_INTERVAL_SEC=10
# Lease: no active peer for this long = takeover; also the primary's cold-start wait
LEASE_TTL_SEC=30
FAILBACK_STABLE_SEC=180

# --- VPN status (optional) ---
# Key of a gluetun control-server auth role allowed to GET /v1/publicip/ip and
# /v1/vpn/status. Blank = no poller, `vpn: null` in /api/status
VPN_CONTROL_APIKEY=
# VPN_CONTROL_URL=http://127.0.0.1:8000

BACKUP_CRON=0 */12 * * *
BACKUP_MAX_COUNT=14
